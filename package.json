{
  "name": "open-claude-ui",
  "version": "1.0.0",
  "description": "基于 REA 深度拆解并高保真还原 Claude 官方桌面端 UI。还原 30 个独立 React 组件与 8 项硬核交互物理算法，附带 3000+ 行逆向分析手册。",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./css": "./code-examples/cds-theme.css",
    "./tokens.css": "./code-examples/cds-theme.css",
    "./tokens": "./code-examples/cds-theme.css",
    "./pure.css": "./code-examples/cds-pure.css",
    "./pure": "./code-examples/cds-pure.css",
    "./tailwind": "./code-examples/tailwind.config.js"
  },
  "files": [
    "dist",
    "code-examples",
    "docs",
    "src",
    "README.md",
    "README-en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "storybook": "open docs/claude-components-storybook.html"
  },
  "keywords": [
    "claude",
    "anthropic",
    "design-system",
    "react",
    "tailwindcss",
    "framer-motion",
    "ui-components",
    "motion-physics",
    "audioworklet"
  ],
  "author": "Caho1",
  "license": "MIT",
  "peerDependencies": {
    "framer-motion": ">=10.0.0",
    "lucide-react": ">=0.280.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.451.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "electron": "^31.0.0"
  }
}
